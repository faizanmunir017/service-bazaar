GEMINI_API_KEY=your_key_here
# Free tier burns fast: each chat uses several Gemini calls. Use rule orchestrator in dev:
USE_RULE_ORCHESTRATOR=true
# Optional: gemini-2.0-flash often has separate quota from gemini-2.5-flash
GEMINI_MODEL=gemini-2.0-flash
# Wait this many seconds before each Gemini call (avoids per-minute 429s). Set 0 to disable.
GEMINI_MIN_INTERVAL_SEC=2.0
# If a 429 still happens, retry up to this many times (does not bypass daily 20/day cap).
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BACKOFF_SEC=2.0
