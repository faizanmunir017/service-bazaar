# ── Gemini client ──────────────────────────────────────────────────
from google import genai

gemini = genai.Client(api_key=os.getenv("GEMINI_API_KEY"))
print("\n\nGEMINI API KEY: {} \n\n".format(os.getenv("GEMINI_API_KEY")))

MODEL  = "gemini-2.5-flash"


def generate_content_with_retry(model: str, contents: str, config=None, max_retries=5, initial_backoff=2.0):
    """Resilient wrapper for Gemini API calls to gracefully handle 429 Rate Limits/Quota issues."""
    import time
    for attempt in range(max_retries):
        try:
            return gemini.models.generate_content(
                model=model,
                contents=contents,
                config=config
            )
        except Exception as e:
            err_str = str(e)
            if "429" in err_str or "quota" in err_str.lower() or "resource_exhausted" in err_str.lower():
                if "daily" in err_str.lower() or "perday" in err_str.lower():
                    # Abort retries on daily limits immediately to allow instant fallback execution
                    raise e
                sleep_time = initial_backoff * (2 ** attempt)
                print(f"\n[RETRY] Gemini API 429 Rate Limit hit. Retrying in {sleep_time:.2f}s... (Attempt {attempt+1}/{max_retries})\n")
                time.sleep(sleep_time)
            else:
                raise e
    return gemini.models.generate_content(model=model, contents=contents, config=config)



# ── FastAPI app ────────────────────────────────────────────────────
