# Set your deployed FastAPI URL (HTTPS, no trailing slash, no /api suffix).
# Example Cloud Run: https://service-bazaar-xxxxx-uc.a.run.app
EXPO_PUBLIC_BACKEND_URL=https://YOUR-DEPLOYED-BACKEND-URL

# Add to EAS before building APK:
#   eas env:create --name EXPO_PUBLIC_BACKEND_URL --value "https://YOUR-URL" --environment preview --visibility plaintext
# Or copy this file to .env and run: eas build -p android --profile preview
